    <!-- APPLICATION LOGIC & INDEXEDDB ENGINE -->
    <script>
        // --- CONSTANTS ---
        const FREE_QUOTA_BYTES = 1000 * 1024 * 1024; // 1,000 MB (1 GB)
        const CHUNK_SIZE = 10 * 1024 * 1024; // 10 MB per chunk

        let db = null;
        let storageChart = null;

        // --- INDEXEDDB INITIALIZATION ---
        function initDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open('CloudVaultDB', 1);
                request.onupgradeneeded = (e) => {
                    const database = e.target.result;
                    if (!database.objectStoreNames.contains('files')) {
                        database.createObjectStore('files', { keyPath: 'id' });
                    }
                };
                request.onsuccess = (e) => {
                    db = e.target.result;
                    resolve(db);
                };
                request.onerror = (e) => reject(e);
            });
        }

        // Fetch all files from IndexedDB
        function getAllFilesDB() {
            return new Promise((resolve) => {
                if (!db) return resolve([]);
                const tx = db.transaction('files', 'readonly');
                const store = tx.objectStore('files');
                const req = store.getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => resolve([]);
            });
        }

        // Save a single file record to IndexedDB
        function saveFileDB(fileRecord) {
            return new Promise((resolve, reject) => {
                if (!db) return reject('Database not ready');
                const tx = db.transaction('files', 'readwrite');
                const store = tx.objectStore('files');
                const req = store.put(fileRecord);
                req.onsuccess = () => resolve();
                req.onerror = (e) => reject(e);
            });
        }

        // Delete a file record from IndexedDB
        function deleteFileDB(id) {
            return new Promise((resolve) => {
                if (!db) return resolve();
                const tx = db.transaction('files', 'readwrite');
                const store = tx.objectStore('files');
                store.delete(id);
                tx.oncomplete = () => resolve();
            });
        }

        // --- APP STATE ENGINE ---
        window.onload = async function() {
            try {
                await initDB();
                await refreshVaultUI();
                initChart();
            } catch (err) {
                console.error('Failed to initialize local IndexedDB:', err);
            }
        };

        // --- TAB SWITCHER ---
        function switchTab(tabId) {
            ['files', 'upload', 'analytics', 'monetization'].forEach(id => {
                const sec = document.getElementById('tab-' + id);
                const nav = document.getElementById('nav-' + id);
                if (id === tabId) {
                    sec.classList.remove('hidden');
                    nav.className = "w-full flex items-center space-x-3 px-3 py-3 rounded-xl text-xs font-semibold text-cyan-300 bg-slate-800/80 border border-cyan-500/30 shadow-sm transition-all";
                } else {
                    sec.classList.add('hidden');
                    nav.className = "w-full flex items-center space-x-3 px-3 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/40 transition-all";
                }
            });
            if (tabId === 'analytics') updateChartData();
        }

        // --- QUOTA & FILE REFRESH ENGINE ---
        async function refreshVaultUI() {
            const files = await getAllFilesDB();
            
            // Calculate usage
            let totalBytes = files.reduce((acc, f) => acc + (f.size || 0), 0);
            let usedMB = (totalBytes / (1024 * 1024)).toFixed(1);
            let freeMB = Math.max(0, (1000 - usedMB)).toFixed(1);
            let pct = Math.min(100, (totalBytes / FREE_QUOTA_BYTES) * 100).toFixed(1);

            // Update Quota Displays
            document.getElementById('quota-text').innerText = `${usedMB} MB / 1000 MB`;
            document.getElementById('quota-bar').style.width = `${pct}%`;
            document.getElementById('sidebar-quota-bar').style.width = `${pct}%`;
            document.getElementById('sidebar-quota-desc').innerText = `Using ${usedMB} MB of your 1,000 MB free allocation.`;

            // Stats tab updates
            document.getElementById('stat-total-files').innerText = files.length;
            document.getElementById('stat-space-used').innerText = `${usedMB} MB`;
            document.getElementById('stat-space-free').innerText = `${freeMB} MB`;
            document.getElementById('file-count-badge').innerText = `${files.length} Files`;

            // Render File Grid
            const grid = document.getElementById('file-grid');
            const empty = document.getElementById('empty-state');
            grid.innerHTML = '';

            if (files.length === 0) {
                empty.classList.remove('hidden');
            } else {
                empty.classList.add('hidden');
                files.forEach(f => {
                    const card = document.createElement('div');
                    card.className = "glass-card p-4 rounded-xl space-y-3 flex flex-col justify-between hover:border-cyan-500/30 transition group";
                    
                    let iconClass = "fa-file text-slate-400";
                    if (f.type.includes('image')) iconClass = "fa-file-image text-cyan-400";
                    else if (f.type.includes('video')) iconClass = "fa-file-video text-purple-400";
                    else if (f.type.includes('pdf') || f.type.includes('text')) iconClass = "fa-file-lines text-emerald-400";
                    else if (f.type.includes('zip') || f.type.includes('rar')) iconClass = "fa-file-zipper text-amber-400";

                    card.innerHTML = `
                        <div class="flex items-start justify-between space-x-2">
                            <div class="flex items-center space-x-3 truncate">
                                <div class="w-10 h-10 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center shrink-0">
                                    <i class="fa-solid ${iconClass} text-lg"></i>
                                </div>
                                <div class="truncate">
                                    <h4 class="text-xs font-bold text-white truncate">${escapeHTML(f.name)}</h4>
                                    <span class="text-[10px] text-slate-400 font-mono">${(f.size / (1024 * 1024)).toFixed(2)} MB</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs">
                            <span class="text-[10px] text-slate-500">${new Date(f.uploadedAt).toLocaleDateString()}</span>
                            <button onclick="removeFile('${f.id}')" class="text-slate-500 hover:text-red-400 transition p-1" title="Delete File">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    `;
                    grid.appendChild(card);
                });
            }
        }

        // --- FILE SELECTION & CHUNKING SIMULATION ---
        async function handleFileSelect(e) {
            const selectedFiles = Array.from(e.target.files);
            if (!selectedFiles.length) return;

            const existingFiles = await getAllFilesDB();
            let currentBytes = existingFiles.reduce((acc, f) => acc + (f.size || 0), 0);

            for (const file of selectedFiles) {
                // Quota Check
                if (currentBytes + file.size > FREE_QUOTA_BYTES) {
                    showQuotaModal();
                    break;
                }

                // Process Chunked Upload
                await processChunkedUpload(file);
                currentBytes += file.size;
            }

            await refreshVaultUI();
            e.target.value = ''; // Reset input
        }

        function processChunkedUpload(file) {
            return new Promise((resolve) => {
                const queue = document.getElementById('upload-queue');
                const fileId = 'file_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4);

                // Add item to upload UI queue
                const item = document.createElement('div');
                item.id = fileId;
                item.className = "glass-card p-4 rounded-xl space-y-2 border border-slate-800";
                item.innerHTML = `
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-bold text-white truncate max-w-xs">${escapeHTML(file.name)}</span>
                        <span id="${fileId}-status" class="font-mono text-cyan-400 text-[11px]">Chunking 0%</span>
                    </div>
                    <div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden">
                        <div id="${fileId}-bar" class="h-full bg-gradient-to-r from-cyan-400 to-emerald-400 w-0 transition-all duration-150"></div>
                    </div>
                `;
                queue.appendChild(item);

                let offset = 0;
                const totalSize = file.size;

                function uploadNextChunk() {
                    offset += CHUNK_SIZE;
                    let pct = Math.min(100, Math.round((offset / totalSize) * 100));

                    document.getElementById(`${fileId}-bar`).style.width = `${pct}%`;
                    document.getElementById(`${fileId}-status`).innerText = `Chunking ${pct}%`;

                    if (offset < totalSize) {
                        setTimeout(uploadNextChunk, 80); // Simulate network chunk processing speed
                    } else {
                        // Complete Upload & Save to IndexedDB
                        saveFileDB({
                            id: fileId,
                            name: file.name,
                            size: file.size,
                            type: file.type || 'application/octet-stream',
                            uploadedAt: new Date().toISOString()
                        }).then(() => {
                            setTimeout(() => {
                                item.remove();
                                resolve();
                            }, 400);
                        });
                    }
                }

                uploadNextChunk();
            });
        }

        // Delete File
        async function removeFile(id) {
            await deleteFileDB(id);
            await refreshVaultUI();
        }

        // Quota Modal Helpers
        function showQuotaModal() {
            document.getElementById('quota-modal').classList.remove('hidden');
            document.getElementById('quota-modal').classList.add('flex');
        }

        function closeQuotaModal() {
            document.getElementById('quota-modal').classList.add('hidden');
            document.getElementById('quota-modal').classList.remove('flex');
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }

        // --- CHART ENGINE ---
        function initChart() {
            const ctx = document.getElementById('storageChart').getContext('2d');
            storageChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Documents & Code', 'Media & Images', 'Available Free Quota'],
                    datasets: [{
                        data: [0, 0, 1000],
                        backgroundColor: ['#22d3ee', '#a855f7', '#1e293b'],
                        borderColor: '#0b0f19',
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#94a3b8', font: { size: 11 } } }
                    }
                }
            });
        }

        async function updateChartData() {
            if (!storageChart) return;
            const files = await getAllFilesDB();
            let totalBytes = files.reduce((acc, f) => acc + (f.size || 0), 0);
            let usedMB = (totalBytes / (1024 * 1024)).toFixed(1);
            let freeMB = Math.max(0, (1000 - usedMB)).toFixed(1);

            storageChart.data.datasets[0].data = [usedMB * 0.4, usedMB * 0.6, freeMB];
            storageChart.update();
        }
    </script>
</body>
</html>
